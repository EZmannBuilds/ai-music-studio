{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional append-only project decision event",
  "type": "object",
  "required": [
    "id",
    "when",
    "scope",
    "decision",
    "reason",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "approved_by": {
      "enum": [
        "user",
        "delegated_agent",
        "not_approved"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "render_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
