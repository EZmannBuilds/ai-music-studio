# user profiles and anything local never leave the machine.
# The folder itself is tracked, with only its README, so that the path the
# Music Director looks in exists in a fresh clone.
profiles/local/*
!profiles/local/README.md
*.local.yaml
*.local.json

# OS and editor clutter
.DS_Store
Thumbs.db
*.swp

# evaluation runs: the replies and reports an agent run produces stay local
evals/reports/runs/
__pycache__/
